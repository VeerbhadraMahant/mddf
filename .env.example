# Copy to .env for local overrides. All settings are optional; defaults are in
# src/mddf/config.py. Prefix is MDDF_.

# MDDF_LOG_LEVEL=DEBUG
# MDDF_LOG_JSON=false
# MDDF_DEFAULT_MODEL=patchcore
# MDDF_INPUT_SIZE=256
# MDDF_MAX_UPLOAD_BYTES=8388608

# Where exported artifacts are pulled from at runtime.
# MDDF_HF_MODEL_REPO=bhadra244131/mddf-artifacts
# MDDF_HF_REVISION=main
# MDDF_PREFETCH_ON_STARTUP=false
# MDDF_PREFER_INT8=true
