# Keep the build context small. NOTE: web/dist and src/ must NOT be excluded — the
# image needs the built SPA and the package source.
.git
.github
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
coverage.xml

# Training-only material — never needed in the runtime image.
datasets/
artifacts/
outputs/
lightning_logs/
results/
notebooks/
*.ckpt

# Frontend: the image rebuilds the SPA in the node stage
web/node_modules
web/.vite
web/dist

# Docs / meta
docs/
*.md
!README.md
